<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ note.title }} — DATATRAIN AI 트레이딩</title>
<link rel="stylesheet" href="{{ css_path }}">
<style>
{{ inline_css }}
</style>
<script>
window.MathJax = {
  tex: {
    inlineMath: [['$', '$'], ['\\(', '\\)']],
    displayMath: [['$$', '$$'], ['\\[', '\\]']],
    processEscapes: true
  },
  options: {
    skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
  }
};
</script>
<script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
</head>
<body>
<div class="docs-shell">
  {% include "sidebar.html.j2" %}

  <div class="docs-main">
    <header class="docs-topbar">
      <button class="sidebar-toggle" type="button" aria-label="목차 열기">☰</button>
      <div class="crumb">
        Part {{ "%02d"|format(note.part) }} · CH{{ "%02d"|format(note.chapter) }} · Clip {{ "%02d"|format(note.clip_num) }}
      </div>
      <a class="topbar-link" href="{{ index_href }}">전체 목차 ↗</a>
    </header>

    <div class="docs-content">
      <div class="note-header">
        <div class="kicker">Part {{ "%02d"|format(note.part) }}. {{ note.part_title }}</div>
        <h1>{{ note.title }}</h1>

        <div class="metadata-bar">
          <div class="metadata-item">
            <span class="label">Chapter:</span>
            <span>CH{{ "%02d"|format(note.chapter) }}. {{ note.chapter_title }}</span>
          </div>
          <div class="metadata-item">
            <span class="label">예상 소요 시간:</span>
            <span class="badge time">약 {{ note.duration }}분</span>
          </div>
          <div class="metadata-item">
            <span class="label">강의 유형:</span>
            {% if note.practice %}
            <span class="badge practice">{{ note.practice }} (실습 중심)</span>
            {% else %}
            <span class="badge">이론 및 아키텍처 브리핑</span>
            {% endif %}
          </div>
        </div>
      </div>

      <main>
        {{ content }}
      </main>

      <nav class="pager-nav">
        {% if prev %}
        <a class="pager-btn prev" href="{{ prev.href }}">
          <span class="direction">← 이전 클립</span>
          <span class="title">{{ prev.title }}</span>
        </a>
        {% else %}
        <div></div>
        {% endif %}
        {% if next %}
        <a class="pager-btn next" href="{{ next.href }}">
          <span class="direction">다음 클립 →</span>
          <span class="title">{{ next.title }}</span>
        </a>
        {% endif %}
      </nav>

      <footer class="site-footer">
        <span>© DATATRAIN. All rights reserved.</span>
        <span>코딩 몰라도 완성하는 나만의 AI 트레이딩 시스템 w. Claude Code</span>
        {% if fastcampus_logo_data_uri %}
        <img class="footer-logo" src="{{ fastcampus_logo_data_uri }}" alt="Fastcampus">
        {% endif %}
      </footer>
    </div>
  </div>
</div>

<script>
// Prompt Card copy button handler
document.querySelectorAll(".prompt-card").forEach(function (card) {
  var btn = card.querySelector(".copy-btn");
  if (!btn) return;
  var code = card.querySelector("pre code") || card.querySelector("pre");
  btn.addEventListener("click", function () {
    navigator.clipboard.writeText(code ? code.innerText.trim() : "").then(function () {
      btn.textContent = "복사 완료!";
      setTimeout(function () { btn.textContent = "프롬프트 복사"; }, 1500);
    });
  });
});

// Mobile Sidebar Toggle
var toggle = document.querySelector(".sidebar-toggle");
var sidebar = document.getElementById("docs-sidebar");
if (toggle && sidebar) {
  toggle.addEventListener("click", function () {
    sidebar.classList.toggle("is-open");
  });
}
</script>
</body>
</html>
